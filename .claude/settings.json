{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(gh run rerun:*)",
      "Bash(bun run release)",
      "Bash(bun run release --dry-run)",
      "Bash(gh pr merge:*)",
      "PowerShell(gh pr merge:*)",
      "Bash(git push origin origin/beta:main)"
    ]
  },
  "env": {
    "LANG": "C.UTF-8",
    "LC_ALL": "C.UTF-8",
    "GIT_TERMINAL_PROMPT": "0",
    "GIT_EDITOR": "true",
    "GIT_PAGER": "cat",
    "PAGER": "cat",
    "GIT_SSH_COMMAND": "ssh -oBatchMode=yes"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Monitor is banned in this repo: a monitor dies when the turn ends. Never watch CI: lane:close hands the PR to the landing queue. For a long job (the queue, a fit, a perf run): bun run background start -- <cmd>, then bun run background await <id> as a harness background command (Bash run_in_background), and end the turn; its exit calls you back.\"}}'"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/fan-out-guard.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/repetitive-edit-watch.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/session-start.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/warn-unpushed.mjs"
          }
        ]
      }
    ]
  }
}
