# No trailing slash: a worktree's node_modules is a symlink, which `dir/` patterns miss.
node_modules
dist/
*.log
.DS_Store
shots/
**/public/models/*
!**/public/models/imported/
!apps/dev/public/models/material-showcase/
!apps/dev/public/models/lantern-reach/
!apps/dev/public/models/kaykit-adventurers/
!apps/dev/public/models/kaykit-city-builder/
!apps/dev/public/models/kaykit-dungeon/
!apps/dev/public/models/kaykit-furniture/
!apps/dev/public/models/kaykit-skeletons/
!apps/dev/public/models/kaykit-space-base/
!apps/dev/public/models/quaternius-5-low-poly-animals/
!apps/dev/public/models/quaternius-animated-fish/
!apps/dev/public/models/quaternius-medieval-village/
!apps/dev/public/models/quaternius-lowpoly-cars/
!apps/dev/public/models/quaternius-modular-scifi/
!apps/dev/public/models/quaternius-stylized-nature/
!apps/dev/public/models/quaternius-textured-cute-monster-pack/
**/.jgengine-assets-tmp/
*.tsbuildinfo

# Orphaned per-package API JSON dumped under the web app — build output, not source.
apps/web/src/generated/

# CHANGELOG.md is authored once at the repo root and copied into each package
# at publish time (see publish.yml) — the per-package copies are build artifacts.
packages/*/CHANGELOG.md

# Compiled output must never sit beside TS source — Vite resolves .js over .ts,
# so a stray src/*.js silently shadows its .ts sibling and breaks dev/shoot.
# Source dirs are pure TypeScript; emit only ever goes to dist/.
packages/*/src/**/*.js
packages/*/src/**/*.jsx
packages/*/src/**/*.d.ts
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts.map

# Packaged skills are staged from .claude/skills into packages/*/skills by
# scripts/stage-skills.ts — never author or commit these by hand.
packages/*/skills/

# Ephemeral git worktrees created by parallel shipping subagents
# (Agent({ isolation: "worktree" })) - transient, never committed.
.claude/worktrees/

# Painted material maps a demo pulls with `assets pull library` (~360 MB for the whole library).
apps/dev/public/library-materials/


# agent-bootstrap concurrency guard (never race two bun installs),
# hook-spawned background log, and killed-install detection marker
.agent-bootstrap.lock
.agent-bootstrap.log
.agent-bootstrap.installing
apps/web/.wrangler/

# One checkout home and one scratch folder (JonsOCsetup docs/worktrees.md)
.scratch/

# The shared asset store every checkout links pulled packs from (packages/assets/src/assetStore.ts).
/.asset-store/

# Web pages `bun run data-table` fetched, kept in the main checkout for every worktree.
.web-cache/
# Shared asset library pulls (assets pull <source>:<id>); bytes live in the shared asset store.
**/public/sprites/gameicons-icons/
**/public/hdri/
**/public/fonts/
**/public/models/sketchfab/
**/public/materials/polyhaven-*/

# Colour grades are baked by games:provision from packages/assets (lutGrades.ts)
**/public/lut/

# Curated fonts are linked by games:provision from the shared asset store
**/public/fonts/
