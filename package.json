{
  "name": "jgengine-monorepo",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "examples/*",
      "registry",
      "games/*",
      "games/llmville/packages/*"
    ],
    "catalog": {
      "@convex-dev/better-auth": "^0.10.9",
      "@react-three/drei": "^10.7.9",
      "@react-three/fiber": "^9.8.2",
      "@tailwindcss/vite": "^4.3.3",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "@types/three": "^0.187.0",
      "@vitejs/plugin-react": "^6.1.2",
      "better-auth": "1.4.9",
      "convex": "1.42.2",
      "dotenv": "^17.2.2",
      "react": "19.2.3",
      "react-dom": "19.2.3",
      "tailwindcss": "^4.0.15",
      "three": "^0.187.0",
      "three-stdlib": "^2.36.1",
      "typescript": "^5",
      "vite": "^8.3.5",
      "zod": "^4.1.13"
    }
  },
  "scripts": {
    "agent:bootstrap": "bun scripts/agent-bootstrap.ts",
    "worktree": "bun scripts/worktree.ts",
    "preflight": "bun scripts/agent-preflight.ts",
    "verify:fast": "bun scripts/verify-fast.ts",
    "lane:close": "bun scripts/lane-close.ts",
    "ci:status": "bun scripts/ci-status.ts",
    "background": "bun scripts/background.ts",
    "find": "bun packages/jgengine/src/cli/index.ts find",
    "idea-clock": "bun scripts/idea-clock.ts",
    "part-stats": "bun scripts/part-stats.ts",
    "jgengine": "bun packages/jgengine/src/cli/index.ts",
    "data-table": "bun scripts/data-table.ts",
    "check": "bun scripts/guard.ts 600 'bun scripts/run-stages.ts check'",
    "gen": "bun scripts/guard.ts 600 'bun scripts/run-stages.ts gen'",
    "test": "bun scripts/guard.ts 600 'bun scripts/ensure-ready.ts --install-only && bun test packages apps/dev apps/web apps/desktop scripts'",
    "test:repeat": "bun scripts/repeat-tests.ts",
    "build": "bun scripts/guard.ts 600 'bun scripts/ensure-ready.ts --install-only && bun run --cwd packages/core build && bun run --cwd packages/rapier build && bun run --cwd packages/ws build && bun run --cwd packages/sql build && bun run --cwd packages/navbake build && bun run --cwd packages/convex build && bun run --cwd packages/node build && bun run --cwd packages/assets build && bun run --cwd packages/editor build && bun run --cwd packages/github build && bun run --cwd packages/jgengine build && bun scripts/build-registry.ts'",
    "dev:site": "bun --cwd=apps/web run dev",
    "dev:games": "bun --cwd=apps/dev run dev",
    "shoot": "bun scripts/shoot.ts",
    "drive": "bun scripts/guard.ts 600 'bun scripts/drive-dev.ts'",
    "perf": "bun scripts/perf.ts",
    "simulate": "bun scripts/simulate.ts",
    "pr:shots": "bun scripts/pr-shots.ts",
    "host:game": "bun scripts/host-game.ts",
    "host:fixture": "node scripts/authority-fixture.mjs",
    "release": "bun scripts/release.ts",
    "deploy:site": "bun scripts/deploy-site.ts",
    "games:provision": "bun games/scripts/provision-assets.ts",
    "games:compress": "bun games/scripts/compress-textures.ts",
    "games:capabilities": "bun games/scripts/capabilities-tools.ts"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/bun": "^1.4.4",
    "@typescript/native-preview": "^7.0.0-dev.20260705.1",
    "gifenc": "^1.0.3",
    "jpeg-js": "0.4.4",
    "ktx2-encoder": "0.6.0",
    "playwright-core": "^1.50.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5.9.3",
    "user-attachments": "^2.0.2"
  },
  "packageManager": "bun@1.4.2"
}
