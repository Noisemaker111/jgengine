{
  "name": "@jgengine-apps/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun --cwd=../.. run build && vite build && bun scripts/prerender.ts",
    "build:checked": "bun run build && bun ../../scripts/check-site-assets.ts",
    "deploy:cloudflare": "bun run build:checked && wrangler deploy",
    "check-types": "tsgo --noEmit -p tsconfig.json",
    "start": "wrangler dev"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@jgengine/core": "workspace:*",
    "@jgengine/github": "workspace:*",
    "three": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "^24",
    "@types/three": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "wrangler": "^4.127.1"
  }
}
