+import type { MaterialAsset, MaterialAssignment } from "@jgengine/core/material/materialAsset";
+
+export const parkMaterials: readonly MaterialAsset[] = [
+  { schemaVersion: 1, id: "brightway/guest-satin", name: "Brightway summer satin", family: "fabric", capabilities: ["pbr", "sheen", "anisotropy"],
+    provenance: { author: "Brightway Park contributors", license: "Apache-2.0", sourceUrl: "https://github.com/Noisemaker111/JGengine-games/tree/beta/brightway-park" },
+    surface: { roughness: 0.38, sheen: 0.28, sheenColor: "#fff1cf", sheenRoughness: 0.3, anisotropy: 0.65 },
+    fabric: { construction: "woven", weaveDirection: 0, threadScale: 40, normalStrength: 0.07, variation: 0.035 } },
+  { schemaVersion: 1, id: "brightway/fairground-gold", name: "Lacquered fairground gold", family: "metal", capabilities: ["pbr", "clearcoat"],
+    provenance: { author: "Brightway Park contributors", license: "Apache-2.0", sourceUrl: "https://github.com/Noisemaker111/JGengine-games/tree/beta/brightway-park" },
+    surface: { metalness: 0.55, roughness: 0.3, clearcoat: 0.65, clearcoatRoughness: 0.2 } },
+];
+
+/** Imported r182 names from the original committed guest meshes; omitted skin, shoes, hair and backpack retain their original materials. */
+const guestMaterialAssignments: readonly MaterialAssignment[] = [
+  { materialId: "brightway/guest-satin", selector: { mesh: "mesh_4", slotIndex: 0 } },
+  { materialId: "brightway/fairground-gold", selector: { mesh: "mesh_9", slotIndex: 0 } },
+];
+export function guestMaterialAssignmentsFor(id: string): readonly MaterialAssignment[] {
+  return ["guest_a", "guest_c", "guest_e"].includes(id) ? guestMaterialAssignments : guestMaterialAssignments.slice(0, 1);
+}
+export const carouselMaterialAssignments: readonly MaterialAssignment[] = [
+  { materialId: "brightway/fairground-gold", selector: { mesh: "mesh_2", slotIndex: 0 } },
+];
