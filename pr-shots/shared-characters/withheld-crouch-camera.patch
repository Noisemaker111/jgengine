diff --git a/packages/shell/src/camera/firstPersonStance.test.ts b/packages/shell/src/camera/firstPersonStance.test.ts
new file mode 100644
index 00000000..d73f2a3d
--- /dev/null
+++ b/packages/shell/src/camera/firstPersonStance.test.ts
@@ -0,0 +1,110 @@
+import { afterEach, beforeEach, describe, expect, test } from "bun:test";
+import { act, createRoot, type ReconcilerRoot, type RootStore } from "@react-three/fiber";
+import { createElement } from "react";
+import * as THREE from "three";
+import { createGameContext } from "@jgengine/core/runtime/gameContext";
+import { defineGameDefinition } from "@jgengine/core/game/defineGame";
+import { createAssetCatalog } from "@jgengine/core/scene/assetCatalog";
+import { createPhysicsWorldBackend } from "@jgengine/core/physics/physicsWorldBackend";
+import { playerMovementTelemetry, resolvePlayerMovementTuning, stepPlayerMovement, type PlayerMovementTuning } from "@jgengine/core/movement/playerMovement";
+import type { FirstPersonCameraConfig } from "@jgengine/core/game/playableGame";
+import { GameProvider } from "@jgengine/react/provider";
+import { GameFirstPersonCamera } from "./GameFirstPersonCamera";
+import { firstPersonEyeHeight } from "./firstPersonStance";
+
+const roots: ReconcilerRoot<HTMLCanvasElement>[] = [];
+const actEnvironment = globalThis as typeof globalThis & { IS_REACT_ACT_ENVIRONMENT?: boolean };
+const previousActEnvironment = actEnvironment.IS_REACT_ACT_ENVIRONMENT;
+const previousWindow = Object.getOwnPropertyDescriptor(globalThis, "window");
+beforeEach(() => {
+  actEnvironment.IS_REACT_ACT_ENVIRONMENT = true;
+  Object.defineProperty(globalThis, "window", { configurable: true, value: { addEventListener() {}, removeEventListener() {} } });
+});
+afterEach(async () => {
+  for (const root of roots.splice(0)) await act(async () => root.unmount());
+  actEnvironment.IS_REACT_ACT_ENVIRONMENT = previousActEnvironment;
+  if (previousWindow === undefined) Reflect.deleteProperty(globalThis, "window");
+  else Object.defineProperty(globalThis, "window", previousWindow);
+});
+
+async function harness(config: FirstPersonCameraConfig = { eyeHeight: 1.62, viewmodel: false }, followEntityId = "survivor") {
+  const ctx = createGameContext({
+    definition: defineGameDefinition({ name: "crouch-camera", assets: createAssetCatalog(), multiplayer: "off", features: { players: true } }),
+    content: { entityById: () => ({ movement: { poses: ["standing", "running", "crouch"] } }) },
+    player: { userId: "survivor", isNew: true },
+  });
+  ctx.game.players?.join("survivor", true);
+  ctx.scene.entity.spawn("hero", { id: "survivor", position: [0, 0, 0] });
+  if (followEntityId !== "survivor") ctx.scene.entity.spawn("hero", { id: followEntityId, position: [0, 3, 0] });
+  const camera = new THREE.PerspectiveCamera();
+  const root = createRoot({} as HTMLCanvasElement);
+  roots.push(root);
+  await root.configure({
+    camera, frameloop: "never", size: { width: 100, height: 100, top: 0, left: 0 }, dpr: 1,
+    gl: () => ({ render() {}, setSize() {}, setPixelRatio() {}, domElement: { addEventListener() {}, removeEventListener() {} } }) as unknown as THREE.WebGLRenderer,
+  });
+  let store: RootStore;
+  await act(async () => {
+    store = root.render(createElement(GameProvider, { context: ctx }, createElement(GameFirstPersonCamera, {
+      yawRef: { current: 0 }, pitchRef: { current: 0 }, config, followEntityId,
+    })));
+  });
+  const frame = () => {
+    const state = store.getState();
+    state.advance(state.clock.elapsedTime + 1 / 60, false);
+    return camera.position.y - ctx.scene.entity.get(followEntityId)!.position[1];
+  };
+  const move = (held: string[], tuning: PlayerMovementTuning = resolvePlayerMovementTuning({})) => {
+    stepPlayerMovement(ctx, "survivor", { held, pointer: null }, 1 / 60, tuning);
+    return frame();
+  };
+  return { ctx, frame, move, camera };
+}
+
+describe("first-person accepted stance", () => {
+  test("standing defaults and authored crouch heights remain independently configurable", () => {
+    expect(firstPersonEyeHeight(undefined, null)).toBe(1.62);
+    expect(firstPersonEyeHeight(undefined, { crouching: true })).toBe(1.62 * 0.6);
+    expect(firstPersonEyeHeight({ eyeHeight: 1.8, crouchEyeHeight: 0.82 }, { crouching: false })).toBe(1.8);
+    expect(firstPersonEyeHeight({ eyeHeight: 1.8, crouchEyeHeight: 0.82 }, { crouching: true })).toBe(0.82);
+    expect(firstPersonEyeHeight({ eyeHeight: 1.8, crouchEyeHeight: 0.82 }, undefined)).toBe(1.8);
+  });
+
+  test("the real first-person camera lowers and restores its view with shared crouch", async () => {
+    const h = await harness();
+    expect(h.move([])).toBeCloseTo(1.62, 8);
+    const crouched = h.move(["crouch"]);
+    expect(playerMovementTelemetry(h.ctx, "survivor")!.crouching).toBe(true);
+    expect(crouched).toBeCloseTo(1.62 * 0.6, 8);
+    expect(h.move([])).toBeCloseTo(1.62, 8);
+  });
+
+  test("headroom refusal keeps the camera crouched after the input is released", async () => {
+    const backend = createPhysicsWorldBackend({ capacity: 16, bounds: { min: [-20, -5, -20], max: [20, 20, 20] }, warn: false });
+    backend.addBody({ shape: { kind: "box", halfExtents: [10, 0.5, 10] }, position: [0, -0.5, 0], kind: "static" });
+    const ceiling = backend.addBody({ shape: { kind: "box", halfExtents: [2, 0.1, 2] }, position: [0, 1.4, 0], kind: "static" });
+    const tuning = resolvePlayerMovementTuning({ physics: { backend } });
+    const h = await harness();
+    expect(h.move(["crouch"], tuning)).toBeCloseTo(1.62 * 0.6, 8);
+    expect(h.move([], tuning)).toBeCloseTo(1.62 * 0.6, 8);
+    expect(playerMovementTelemetry(h.ctx, "survivor")!.crouching).toBe(true);
+    backend.removeBody(ceiling);
+    expect(h.move([], tuning)).toBeCloseTo(1.62, 8);
+  });
+
+  test("a custom mover with a crouched pose but no shared telemetry keeps its authored standing view", async () => {
+    const h = await harness({ eyeHeight: 1.8, viewmodel: false }, "custom");
+    h.ctx.player.movement.setPose("custom", "crouch");
+    expect(playerMovementTelemetry(h.ctx, "custom")).toBeNull();
+    expect(h.frame()).toBeCloseTo(1.8, 8);
+  });
+
+  test("the real hook reads live authored crouch height independently of standing height", async () => {
+    const config = { eyeHeight: 1.8, crouchEyeHeight: 0.82, viewmodel: false };
+    const h = await harness(config);
+    expect(h.move(["crouch"])).toBeCloseTo(0.82, 8);
+    config.crouchEyeHeight = 0.9;
+    expect(h.frame()).toBeCloseTo(0.9, 8);
+    expect(h.move([])).toBeCloseTo(1.8, 8);
+  });
+});
