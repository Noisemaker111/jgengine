+import { DEFAULT_EYE_HEIGHT } from "@jgengine/core/combat/shotOrigin";
+import type { FirstPersonCameraConfig } from "@jgengine/core/game/playableGame";
+import type { PlayerMovementTelemetry } from "@jgengine/core/movement/playerMovement";
+
+/** Resolves first-person eye height from accepted shared movement; unknown custom movers retain standing height. */
+export function firstPersonEyeHeight(
+  config: FirstPersonCameraConfig | undefined,
+  movement: Pick<Readonly<PlayerMovementTelemetry>, "crouching"> | null | undefined,
+): number {
+  const standing = config?.eyeHeight ?? DEFAULT_EYE_HEIGHT;
+  return movement?.crouching === true ? config?.crouchEyeHeight ?? standing * 0.6 : standing;
+}
