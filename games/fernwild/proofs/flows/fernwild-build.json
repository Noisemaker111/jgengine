{
  "steps": [
    { "assert": "__jgProbe().health > 0 && __jgProbe().structures === 0", "before": { "is": "typeof __jgProbe === 'function'", "timeoutMs": 60000 }, "note": "arrival on the beach, nothing built" },
    { "rpc": { "method": "run_command", "name": "cheat", "input": { "xp": 2000, "give": { "thatch": 100, "wood": 30, "fiber": 60 } } }, "note": "ARK's admin console: a few levels and the thatch, wood and fiber a hut costs" },
    { "rpc": { "method": "run_command", "name": "learn", "input": { "engramId": "thatch_foundation" } } },
    { "rpc": { "method": "run_command", "name": "learn", "input": { "engramId": "thatch_doorframe" } } },
    { "rpc": { "method": "run_command", "name": "learn", "input": { "engramId": "thatch_wall" } } },
    { "rpc": { "method": "run_command", "name": "learn", "input": { "engramId": "thatch_door" } } },
    { "rpc": { "method": "run_command", "name": "learn", "input": { "engramId": "thatch_ceiling" } }, "note": "five level-4 engrams, 3 points each" },
    { "rpc": { "method": "run_command", "name": "craft", "input": { "recipeId": "thatch_foundation" } } },
    { "rpc": { "method": "run_command", "name": "craft", "input": { "recipeId": "thatch_doorframe" } } },
    { "rpc": { "method": "run_command", "name": "craft", "input": { "recipeId": "thatch_wall", "count": 3 } } },
    { "rpc": { "method": "run_command", "name": "craft", "input": { "recipeId": "thatch_door" } } },
    { "rpc": { "method": "run_command", "name": "craft", "input": { "recipeId": "thatch_ceiling" } }, "note": "craft the hut: 80 thatch, 22 wood, 56 fiber at ARK's prices" },
    { "assert": "__jgProbe().crafting", "is": 7 },
    { "waitFor": "__jgProbe().crafting === 0", "timeoutMs": 40000, "note": "the crafting queue runs down" },
    { "rpc": { "method": "run_command", "name": "cheat", "input": { "toHotbar": ["thatch_foundation", "thatch_doorframe", "thatch_wall", "thatch_door", "thatch_ceiling"] } }, "note": "the pieces onto the hotbar, keys 1 to 5" },
    { "key": "KeyD", "ms": 700, "note": "step onto open sand, clear of the palm by the spawn" },
    { "key": "KeyW", "ms": 250, "note": "face inland, where the camera looks" },
    { "key": "Digit1", "ms": 80, "note": "foundation in hand" },
    { "wait": 500 },
    { "assert": "[__jgProbe().ghost, __jgProbe().holding].join()", "is": "1,1", "note": "a green ghost on the sand" },
    { "shot": "fernwild-build-ghost", "note": "the foundation ghost in front, the HUD says Place Thatch Foundation" },
    { "key": "mouse0", "ms": 80, "until": { "is": "__jgProbe().structures === 1", "timeoutMs": 3000 }, "note": "place it" },
    { "key": "KeyS", "ms": 300, "note": "step back so the build cursor sits on the near edge" },
    { "key": "Digit2", "ms": 80, "note": "doorframe in hand: it snaps to the foundation's edge" },
    { "waitFor": "__jgProbe().ghostSnapped === 1 && __jgProbe().ghost === 1", "timeoutMs": 3000 },
    { "key": "mouse0", "ms": 80, "until": { "is": "__jgProbe().structures === 2", "timeoutMs": 3000 } },
    { "key": "Digit3", "ms": 80, "note": "walls for the two side edges" },
    { "waitFor": "__jgProbe().ghost === 1", "timeoutMs": 3000 },
    { "key": "mouse0", "ms": 80, "until": { "is": "__jgProbe().structures === 3", "timeoutMs": 3000 } },
    { "wait": 400 },
    { "key": "mouse0", "ms": 80, "until": { "is": "__jgProbe().structures === 4", "timeoutMs": 3000 } },
    { "key": "KeyW", "ms": 120, "until": { "is": "__jgProbe().z < 895.4", "timeoutMs": 4000 }, "note": "walk in through the open doorframe so the build cursor reaches the far edge" },
    { "wait": 400 },
    { "assert": "__jgProbe().ghost", "is": 1 },
    { "key": "mouse0", "ms": 80, "until": { "is": "__jgProbe().structures === 5", "timeoutMs": 3000 }, "note": "the back wall" },
    { "key": "Digit5", "ms": 80, "note": "the ceiling snaps onto the wall tops" },
    { "waitFor": "__jgProbe().ghost === 1", "timeoutMs": 3000 },
    { "shot": "fernwild-build-roof-ghost", "note": "from inside: the roof ghost over the walls" },
    { "key": "mouse0", "ms": 80, "until": { "is": "__jgProbe().structures === 6", "timeoutMs": 3000 } },
    { "key": "KeyS", "ms": 120, "until": { "is": "__jgProbe().z > 897.6", "timeoutMs": 4000 }, "note": "back out through the doorway" },
    { "key": "Digit4", "ms": 80, "note": "the door snaps into its frame" },
    { "waitFor": "__jgProbe().ghost === 1", "timeoutMs": 3000 },
    { "key": "mouse0", "ms": 80, "until": { "is": "__jgProbe().structures === 7", "timeoutMs": 3000 } },
    { "wait": 500 },
    { "assert": "__jgProbe().ghost", "is": -1, "note": "the last piece used up: nothing left to build" },
    { "shot": "fernwild-build-hut", "note": "a thatch hut: foundation, three walls, a doorframe with its door, a roof" },
    { "waitFor": "__jgProbe().aimedStructureHealth > 0", "timeoutMs": 3000, "note": "looking at the hut: its name and health under the crosshair" },
    { "key": "KeyE", "ms": 80, "until": { "is": "__jgProbe().doorsOpen === 1", "timeoutMs": 3000 }, "note": "E opens the door" },
    { "wait": 300 },
    { "shot": "fernwild-build-door-open", "note": "the door swung open on its hinge" }
  ]
}