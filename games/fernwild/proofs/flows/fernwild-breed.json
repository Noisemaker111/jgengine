{
  "steps": [
    { "waitFor": "typeof __jgProbe === 'function' && __jgProbe().creatures > 0", "timeoutMs": 60000, "note": "arrival on the beach" },
    { "rpc": { "method": "run_command", "name": "cheat", "input": { "clock": 3500, "teleport": [-1005, 566, 0] } }, "note": "night on the open south coast, facing north: too cold for a raptor egg" },
    { "wait": 1000 },
    { "rpc": { "method": "run_command", "name": "cheat", "input": { "summon": { "species": "raptor", "level": 20, "distance": 6, "side": -3.5, "sex": "female", "tamed": true, "mating": true } } }, "note": "a tamed female raptor, mating on (ARK's GMSummon)" },
    { "rpc": { "method": "run_command", "name": "cheat", "input": { "summon": { "species": "raptor", "level": 20, "distance": 6, "side": -1, "sex": "male", "tamed": true, "mating": true } } }, "note": "and a male beside her" },
    { "waitFor": "__jgProbe().mating === 1", "timeoutMs": 5000, "note": "standing together, they mate" },
    { "wait": 4000, "note": "their models stream in" },
    { "shot": "fernwild-breed-mating", "note": "the raptor pair mating at night" },
    { "waitFor": "__jgProbe().eggs >= 1", "timeoutMs": 75000, "note": "about a minute later she lays a fertilized egg" },
    { "assert": "__jgProbe().eggTemperature < 20", "is": true },
    { "rpc": { "method": "run_command", "name": "cheat", "input": { "give": { "campfire": 1 }, "toHotbar": ["campfire"] } }, "note": "a campfire to the hotbar" },
    { "key": "Digit1", "ms": 80, "note": "campfire in hand" },
    { "key": "mouse0", "ms": 80, "until": { "is": "__jgProbe().eggTemperature >= 20 && __jgProbe().eggTemperature <= 28", "timeoutMs": 3000 }, "note": "lit a few metres from the egg: in a raptor egg's 20-28 °C" },
    { "wait": 1500 },
    { "shot": "fernwild-breed-egg", "note": "the egg by the campfire, incubating" },
    { "rpc": { "method": "run_command", "name": "cheat", "input": { "breedingSpeed": 1000 } }, "note": "ARK's hatch and maturation multipliers, so the proof does not take two hours" },
    { "waitFor": "__jgProbe().babies >= 1", "timeoutMs": 30000, "note": "it hatches" },
    { "assert": "__jgProbe().babySize < 40", "is": true },
    { "wait": 1000 },
    { "shot": "fernwild-breed-hatched", "note": "a baby raptor a quarter of its parents' size" },
    { "waitFor": "__jgProbe().babySize >= 55", "timeoutMs": 80000, "note": "growing up" },
    { "shot": "fernwild-breed-growing", "note": "the juvenile, over half its parents' size" }
  ]
}
