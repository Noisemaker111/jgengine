{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@/components/ui/*": ["../registry/jgengine/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"],
  "extends": "../tsconfig.base.json"
}
