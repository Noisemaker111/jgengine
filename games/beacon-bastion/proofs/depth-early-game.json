{ "steps": [
  { "rpc": { "method": "run_command", "name": "run.begin" } },
  { "waitFor": "/begin first assault/i.test(document.body.innerText)",
    "note": "a fresh defense on Knight, with the horn offering wave 1" },

  { "rpc": { "method": "run_command", "name": "buildTower1" } },
  { "rpc": { "method": "run_command", "name": "tower.build", "input": { "point": [0, 0, 4] } } },
  { "rpc": { "method": "run_command", "name": "buildTower2" } },
  { "rpc": { "method": "run_command", "name": "tower.build", "input": { "point": [-12, 0, -3.2] } } },
  { "rpc": { "method": "sim_advance", "seconds": 5 } },
  { "assert": "__beacon.read().standing === 2",
    "note": "arrival: an archer and a cannon stand on the road's middle bends" },
  { "rpc": { "method": "run_command", "name": "buildTower4" } },
  { "shot": "depth-01-four-towers",
    "note": "the build rack carries four tower lines; the Arcane Sanctum is picked and priced" },

  { "click": "Begin first assault",
    "after": { "is": "__beacon.read().wave === 1" } },
  { "rpc": { "method": "sim_advance", "seconds": 9 } },
  { "assert": "__beacon.read().creeps > 0",
    "note": "arrival: wave 1 is on the road" },
  { "shot": "depth-02-wave-one" },

  { "rpc": { "method": "sim_advance", "seconds": 14 } },
  { "rpc": { "method": "sim_advance", "seconds": 0.2 } },
  { "assert": "/send wave 2/i.test(document.body.innerText) && /marches in/i.test(document.querySelector('.bb-clock')?.getAttribute('aria-label') ?? '')",
    "note": "arrival: wave 1 has fully mustered and the clock to wave 2 is running" },
  { "assert": "document.querySelectorAll('[data-jg=wave-traits] .bb-trait').length >= 1",
    "note": "the horn warns what wave 2 brings (wraiths: flyers)" },
  { "shot": "depth-03-horn-warning" },

  { "click": "Send wave 2",
    "after": { "is": "__beacon.read().wave === 2" },
    "note": "an early call, paid for the seconds it skipped" },
  { "rpc": { "method": "sim_advance", "seconds": 12 } },
  { "rpc": { "method": "run_command", "name": "abilityFire" } },
  { "assert": "document.querySelector('[data-jg=ability-beacon_fire]')?.hasAttribute('data-armed') === true",
    "note": "Beacon Fire is armed and waiting for a point on the road" },
  { "rpc": { "method": "run_command", "name": "tower.build", "input": { "point": [-6, 0, 0] } } },
  { "rpc": { "method": "sim_advance", "seconds": 0.4 } },
  { "shot": "depth-04-beacon-fire",
    "note": "the fire's telegraph on the road, the keystone dark while it recovers" },
  { "assert": "document.querySelector('[data-jg=ability-beacon_fire]')?.hasAttribute('data-dim') === true",
    "note": "arrival: the fire was spent, its keystone recovering" },

  { "rpc": { "method": "sim_advance", "seconds": 60 } },
  { "rpc": { "method": "sim_advance", "seconds": 40 } },
  { "rpc": { "method": "run_command", "name": "tower.build", "input": { "point": [0, 0, 4] } } },
  { "rpc": { "method": "run_command", "name": "upgradeTower" } },
  { "rpc": { "method": "run_command", "name": "upgradeTower" } },
  { "assert": "__beacon.read().towers['tower_archer-1'].level === 3",
    "note": "arrival: the archer climbed both shared ranks on earned gold" },
  { "assert": "/choose a path/i.test(document.body.innerText) && document.querySelectorAll('.bb-branch-card').length === 2",
    "note": "at the fork the card offers two paths, and the U key refuses to pick one" },
  { "shot": "depth-05-branch-fork" }
] }
