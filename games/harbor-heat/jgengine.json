{
  "name": "Harbor Heat",
  "id": "harbor-heat",
  "template": "3d",
  "engine": [
    "assets",
    "core",
    "editor",
    "react",
    "shell",
    "ws"
  ],
  "owns": [
    "index.html",
    "src/index.tsx"
  ],
  "capabilities": {
    "probes": {
      "@jgengine/core/audio/audioProbe.view": [
        "window:__jgengineAudio"
      ],
      "@jgengine/core/economy/transactionLedger": [
        "harbor.ledger"
      ],
      "@jgengine/core/nav/traffic": [
        "harbor.traffic"
      ],
      "@jgengine/core/save/saveDocument": [
        "harbor.save"
      ],
      "@jgengine/core/sim/offScreen": [
        "harbor.residents"
      ]
    },
    "debt": {
      "weapon-system": {
        "reason": "Combat cadence lives in items/use-handlers.ts, which spends the ammo stat itself; the shared weapon runtime cannot take Harbor's ammo pool or present a shot.",
        "issue": 2488
      }
    }
  },
  "assetBuild": {
    "lods": {
      "include": [
        "models/library/city/*/near.gltf",
        "models/library/park/*/near.gltf",
        "models/library/industrial/*/near.gltf",
        "models/library/nature/*/near.gltf"
      ],
      "levels": [
        {
          "ratio": 0.4,
          "error": 0.01
        },
        {
          "ratio": 0.12,
          "error": 0.03
        }
      ]
    },
    "impostors": {
      "include": [
        "models/library/nature/jacaranda/near.gltf",
        "models/library/nature/quiver-tree/near.gltf"
      ],
      "frames": 8,
      "cell": 128
    }
  }
}
