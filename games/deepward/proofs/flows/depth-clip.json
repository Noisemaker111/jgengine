{ "steps": [
  {"assert": "__jgProbe().inDive === 0", "note": "standing in Marrow"},
  {"rpc": {"method": "run_command", "name": "deepward.dev.seed", "input": {"stash": ["cells", "wire", "polymer"], "known": ["cutter", "lure"], "charted": ["cold"]}}},
  {"rpc": {"method": "run_command", "name": "deepward.dev.stand", "input": {"x": -5.2, "z": 15.1}}},
  {"key": "KeyE", "ms": 120, "after": {"is": "/Marrow's fabricator/.test(document.body.innerText)", "timeoutMs": 8000}},
  {"click": "Print Plasma cutter"},
  {"click": "Print Blood lure"},
  {"click": "Back to Marrow"},
  {"assert": "__jgProbe().lures === 1 && __jgProbe().gear === 1"},
  {"rpc": {"method": "run_command", "name": "deepward.dev.stand", "input": {"x": 0, "z": 9.2}}},
  {"key": "KeyE", "ms": 120, "after": {"is": "__jgProbe().inDive === 1", "timeoutMs": 15000}},
  {"rpc": {"method": "run_command", "name": "deepward.dev.stand", "input": {"x": -1.2, "z": -41.6}}},
  {"key": "KeyE", "ms": 120, "after": {"is": "__jgProbe().stratum === 2", "timeoutMs": 8000}, "note": "down to the cold stores"},
  {"key": "KeyF", "ms": 100, "after": {"is": "__jgProbe().lamp === 1", "timeoutMs": 4000}},
  {"key": "KeyS", "ms": 1500, "note": "off the landing"},
  {"rpc": {"method": "run_command", "name": "deepward.dev.stand", "input": {"x": 7.4, "z": 0.2}}},
  {"key": "KeyE", "ms": 120, "note": "cut the cable: loud"},
  {"wait": 3000},
  {"rpc": {"method": "run_command", "name": "deepward.dev.stand", "input": {"x": 0.5, "z": -11}}},
  {"waitFor": "__jgProbe().hunting >= 1", "timeoutMs": 20000, "note": "the courier comes for the lamp"},
  {"wait": 1200},
  {"key": "KeyG", "ms": 100, "after": {"is": "__jgProbe().luresOut === 1", "timeoutMs": 4000}, "note": "blood lure"},
  {"key": "KeyF", "ms": 100, "after": {"is": "__jgProbe().lamp === 0", "timeoutMs": 4000}, "note": "go dark"},
  {"waitFor": "__jgProbe().luresOut === 0", "timeoutMs": 30000, "note": "it eats the lure"},
  {"wait": 1500}
] }
