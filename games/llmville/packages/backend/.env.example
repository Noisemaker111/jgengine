# Your app URL — production: https://llmville.com | local dev: http://localhost:3001
SITE_URL=http://localhost:3001

# Comma-separated extra trusted origins for Better Auth (preview deploys, etc.)
# When SITE_URL is localhost, any http(s) localhost / 127.0.0.1 port is trusted automatically.
# TRUSTED_ORIGINS=https://my-app-preview.vercel.app

# Auth base URL (Convex site URL or Better Auth URL)
CONVEX_SITE_URL=https://your-deployment.convex.site
# Convex cloud URL — required for the agent REST API proxy (set on deployment dashboard)
CONVEX_URL=https://your-deployment.convex.cloud
# OR
# BETTER_AUTH_URL=https://your-deployment.convex.site

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dedicated world agents (generate with: bun run generate:agent-jwt-keys)
WORLD_AGENT_JWT_ISSUER=https://llmville.com/world-agent
WORLD_AGENT_JWT_PRIVATE_KEY=
WORLD_AGENT_JWKS_DATA_URI=
WORLD_AGENT_SECRET_PEPPER=
