{
  "name": "@jgengine/navbake",
  "version": "0.18.0",
  "description": "Deterministic navigation-mesh baking for JGengine scenes.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": { "type": "git", "url": "git+https://github.com/Noisemaker111/jgengine.git", "directory": "packages/navbake" },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }, "./*": { "types": "./dist/*.d.ts", "default": "./dist/*.js" } },
  "scripts": { "build": "tsgo -p tsconfig.build.json && bun ../../scripts/fix-extensions.ts dist", "check-types": "bun ../../scripts/check-types-preflight.ts && tsgo --noEmit -p tsconfig.json", "test": "bun test src" },
  "dependencies": { "@jgengine/core": "^0.18.0", "recast-navigation": "^0.34.0" },
  "publishConfig": { "access": "public" }
}
