{
  "name": "@jgengine/shell",
  "version": "0.45.0",
  "description": "Game player shell for JGengine: React Three Fiber canvas, orbit camera, input tracking, HUD mounting, GameUiPreview, and a demo game. Consumers supply a GameRegistry.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noisemaker111/jgengine.git",
    "directory": "packages/shell"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "skills"
  ],
  "exports": {
    "./weather": {
      "types": "./dist/weather/index.d.ts",
      "default": "./dist/weather/index.js"
    },
    "./camera": {
      "types": "./dist/camera/index.d.ts",
      "default": "./dist/camera/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-engine.ts",
    "check-types": "tsgo --noEmit -p tsconfig.json",
    "test": "bun test src"
  },
  "dependencies": {
    "@jgengine/core": "^0.45.0",
    "@jgengine/react": "^0.45.0",
    "@jgengine/ws": "^0.45.0"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "three": ">=0.170.0",
    "three-stdlib": "^2.0.0"
  },
  "devDependencies": {
    "@react-three/drei": "catalog:",
    "@react-three/fiber": "catalog:",
    "@types/react": "catalog:",
    "@types/three": "catalog:",
    "react": "catalog:",
    "three": "catalog:",
    "three-stdlib": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
