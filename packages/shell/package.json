{
  "name": "@jgengine/shell",
  "version": "0.57.0",
  "description": "Game player shell for JGengine: plain three.js on the engine frame loop, orbit camera, input tracking, HUD mounting, GameUiPreview, and a demo game. Consumers supply a GameRegistry.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noisemaker111/jgengine.git",
    "directory": "packages/shell"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "skills"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-engine.ts",
    "check-types": "tsgo --noEmit -p tsconfig.json",
    "test": "bun test --preload ../../scripts/three-preload.ts src"
  },
  "dependencies": {
    "@jgengine/core": "^0.57.0",
    "@jgengine/ui": "^0.57.0",
    "@jgengine/ws": "^0.57.0"
  },
  "peerDependencies": {
    "three": ">=0.187.0",
    "three-stdlib": "^2.0.0"
  },
  "devDependencies": {
    "@types/three": "catalog:",
    "three": "catalog:",
    "three-stdlib": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
