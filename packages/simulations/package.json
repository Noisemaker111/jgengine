{
  "name": "@jgengine/simulations",
  "private": true,
  "version": "0.59.0",
  "description": "Physical models JGengine games can adopt that no game runs yet: rock fracture, boats, flow corridors and granular experiments, each checked against published references.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noisemaker111/jgengine.git",
    "directory": "packages/simulations"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json && bun ../../scripts/fix-extensions.ts dist",
    "check-types": "tsgo --noEmit -p tsconfig.json",
    "test": "bun test --preload ../../scripts/test-globals-preload.ts src"
  },
  "dependencies": {
    "@jgengine/core": "^0.59.0"
  }
}
