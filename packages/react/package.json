{
  "name": "@jgengine/react",
  "version": "0.48.0",
  "description": "React UI layer for JGengine: GameProvider, hooks, and headless primitives over @jgengine/core.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noisemaker111/jgengine.git",
    "directory": "packages/react"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "skills"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-engine.ts",
    "check-types": "tsgo --noEmit -p tsconfig.json",
    "test": "bun test src",
    "styles": "bun scripts/styles.ts"
  },
  "dependencies": {
    "@jgengine/core": "^0.48.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
