{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "paths": {
      "react": ["../react/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../react/node_modules/@types/react/jsx-runtime.d.ts"],
      "@jgengine/assets": ["../assets/src/index.ts"],
      "@jgengine/assets/*": ["../assets/src/*"],
      "@jgengine/convex": ["../convex/src/index.ts"],
      "@jgengine/convex/*": ["../convex/src/*"],
      "@jgengine/core": ["../core/src/index.ts"],
      "@jgengine/core/*": ["../core/src/*"],
      "@jgengine/editor": ["../editor/src/index.ts"],
      "@jgengine/editor/*": ["../editor/src/*"],
      "@jgengine/github": ["../github/src/index.ts"],
      "@jgengine/github/*": ["../github/src/*"],
      "@jgengine/navbake": ["../navbake/src/index.ts"],
      "@jgengine/navbake/*": ["../navbake/src/*"],
      "@jgengine/node": ["../node/src/index.ts"],
      "@jgengine/node/*": ["../node/src/*"],
      "@jgengine/rapier": ["../rapier/src/index.ts"],
      "@jgengine/rapier/*": ["../rapier/src/*"],
      "@jgengine/react": ["../react/src/index.ts"],
      "@jgengine/react/*": ["../react/src/*"],
      "@jgengine/shell/*": ["../shell/src/*"],
      "@jgengine/sql": ["../sql/src/index.ts"],
      "@jgengine/sql/*": ["../sql/src/*"],
      "@jgengine/ws": ["../ws/src/index.ts"],
      "@jgengine/ws/*": ["../ws/src/*"]
    }
  },
  "include": ["src/recipes/snippets"]
}
