{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "@jgengine/core/*": ["./src/*"]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts", "src/**/*.test.tsx",
    "src/testFixtures.ts"
  ]
}