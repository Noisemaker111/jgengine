{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "../../.scratch/core-build",
    "rootDir": "..",
    "lib": [
      "ES2022",
      "DOM",
      "WebWorker"
    ],
    "paths": {
      "@jgengine/core": [
        "./src/index.ts"
      ],
      "@jgengine/core/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/testFixtures.ts",
    "src/**/testFixtures/**"
  ]
}
