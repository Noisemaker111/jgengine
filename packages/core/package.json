{
  "name": "@jgengine/core",
  "version": "0.57.0",
  "description": "jgengine core — the engine's feature folders (npm @jgengine/core). Each feature keeps its model, UI view (*.view) and three.js draw (*.draw) files together; model files have zero dependencies, so server code imports them alone. Not an ECS. Agent skills ship in the tarball. https://jgengine.com",
  "keywords": [
    "jgengine",
    "agent-first",
    "game-framework",
    "typescript-game-framework",
    "typescript",
    "multiplayer",
    "game-engine"
  ],
  "homepage": "https://jgengine.com",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Noisemaker111/jgengine.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "skills"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./world": {
      "types": "./dist/world.d.ts",
      "default": "./dist/world.js"
    },
    "./combat": {
      "types": "./dist/combat.d.ts",
      "default": "./dist/combat.js"
    },
    "./gameplay": {
      "types": "./dist/gameplay.d.ts",
      "default": "./dist/gameplay.js"
    },
    "./multiplayer": {
      "types": "./dist/multiplayer.d.ts",
      "default": "./dist/multiplayer.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./procedural": {
      "types": "./dist/procedural.d.ts",
      "default": "./dist/procedural.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/build-engine.ts",
    "check-types": "tsgo --noEmit -p tsconfig.json",
    "test": "bun test --preload ../../scripts/three-preload.ts src"
  },
  "peerDependencies": {
    "@jgengine/ui": "^0.57.0",
    "@jgengine/shell": "^0.57.0",
    "three": ">=0.187.0",
    "three-stdlib": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@jgengine/ui": {
      "optional": true
    },
    "@jgengine/shell": {
      "optional": true
    },
    "three": {
      "optional": true
    },
    "three-stdlib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/three": "catalog:",
    "three": "catalog:",
    "three-stdlib": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
